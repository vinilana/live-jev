# Get a key at https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# Optional overrides
# TYPESAFE_DEFAULT_MODEL=jev-latest
# JEV_TIMEOUT_MS=4000
# PORT=3000

# Optional: enables the "Jev vs LLM" side-by-side comparison (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# LLM_TIMEOUT_MS=15000
# OPENROUTER_REASONING=low   # let the LLM think first (slower, more tokens); off by default
# Pricing overrides in USD per million tokens (LLM pricing is fetched from OpenRouter when unset)
# JEV_PRICE_INPUT_PER_M=0.042
# JEV_PRICE_OUTPUT_PER_M=0
# LLM_PRICE_INPUT_PER_M=
# LLM_PRICE_OUTPUT_PER_M=
